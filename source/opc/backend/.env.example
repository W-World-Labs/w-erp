# OPC backend environment variables

# W-ID SSO OAuth Configuration
W_ID_SSO_URL=https://identity.example.invalid
W_ID_CLIENT_ID=
W_ID_CLIENT_SECRET=
W_ID_REDIRECT_URI=http://localhost:8987/auth/callback

# Database
DATABASE_URL=sqlite:data/database.sqlite?mode=rwc

# Server
BIND_HOST=127.0.0.1
PORT=8987
RUST_LOG=info

# Frontend URL (for redirects)
APP_URL=http://localhost:8987

# Radar is provisioned from the W-ID workspace project binding / Radar project env KV.
# Optional telemetry: set your own W_RADAR_CODE and endpoint.
# Backend xradar middleware is no-op when W_RADAR_CODE is unset.
W_RADAR_CODE=
W_RADAR_ENDPOINT=
W_RADAR_SLOW_TRACE_MS=1000
SERVICE_NAME=w-opc
APP_ENV=development

# Optional managed W-Mail business channel. Materialize these runtime values
# from Radar; API_KEY is the exact project's send-only vault credential.
# Tenant SMTP settings never hold or expose this platform credential.
W_ERP_MAIL_URL=
W_ERP_MAIL_PROJECT_ID=
W_ERP_MAIL_MAILBOX_ID=
W_ERP_MAIL_API_KEY=

# Self-update is disabled unless a trusted manifest is explicitly configured.
SELF_UPDATE_MANIFEST_URL=
SELF_UPDATE_AUTO_APPLY=0
