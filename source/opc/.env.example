# OPC Docker Environment
# Copy this file to .env and fill in the values

# OAuth Configuration (required)
W_ID_SSO_URL=https://identity.example.invalid
W_ID_CLIENT_ID=
W_ID_CLIENT_SECRET=
W_ID_REDIRECT_URI=http://localhost:8987/auth/callback

# Application URL (where the Docker image serves the frontend)
APP_URL=http://localhost:8987

# Frontend dev server should call the Rust backend directly.
VITE_API_URL=http://localhost:8987

# CORS Origins (comma-separated, for production)
ALLOWED_ORIGINS=http://localhost:8987,http://localhost:8987,http://localhost:8080,http://localhost:5173

# Server
BIND_HOST=127.0.0.1
PORT=8987
RUST_LOG=info

# Radar is provisioned from the W-ID workspace project binding / Radar project env KV.
# Optional telemetry: set your own W_RADAR_CODE and endpoint.
# Unset or clear in local .env to disable xradar (backend is no-op when unset).
W_RADAR_CODE=
W_RADAR_ENDPOINT=
W_RADAR_SLOW_TRACE_MS=1000
SERVICE_NAME=w-opc
APP_ENV=development


# Self-update is disabled unless a trusted manifest is explicitly configured.
SELF_UPDATE_MANIFEST_URL=
SELF_UPDATE_AUTO_APPLY=0
